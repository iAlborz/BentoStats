<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac App Store build's entitlements; Scripts/appstore.sh signs with these, and
  Organizer adds the team and app identifiers when it signs for distribution.

  - The sandbox, which every App Store app runs in.
  - Outgoing connections, for the public IP lookup, which is off until the user turns
    it on in Settings.

  No exception for the SMC: App Review refused it (Guideline 2.4.5(i)), so the store's
  copy shows the thermal state in place of temperatures and fan speeds. See
  Capabilities.readsSensors.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
