    "macOS does not report core frequency on Apple Silicon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meldet auf Apple Silicon keine Kernfrequenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no informa de la frecuencia de los núcleos en los Mac con chip de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n'indique pas la fréquence des cœurs sur Apple Silicon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tidak melaporkan frekuensi inti pada Apple Silicon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non indica la frequenza dei core sui Mac con Apple Silicon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleシリコンでは、macOSはコアの周波数を報告しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 실리콘에서는 macOS가 코어 주파수를 보고하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meldt geen kernfrequentie op Apple Silicon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Macach z czipem Apple macOS nie podaje częstotliwości rdzeni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não informa a frequência dos núcleos em Macs com Apple Silicon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac с чипом Apple macOS не сообщает частоту ядер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Apple Silicon'da çekirdek frekansını bildirmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple 芯片上，macOS 不提供核心频率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple 晶片上，macOS 不會回報核心頻率。"
          }
        }
      }
    },
    "macOS is not allowing Bento Stats to send notifications, so these rules cannot alert you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt Bento Stats keine Mitteilungen, daher können dich diese Regeln nicht benachrichtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no permite que Bento Stats envíe notificaciones, así que estas reglas no pueden avisarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n'autorise pas Bento Stats à envoyer des notifications, ces règles ne peuvent donc pas vous alerter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tidak mengizinkan Bento Stats mengirim notifikasi, sehingga aturan ini tidak dapat memberi tahu Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non consente a Bento Stats di inviare notifiche, quindi queste regole non possono avvisarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSでBento Statsからの通知が許可されていないため、これらのルールで通知することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 Bento Stats의 알림이 허용되지 않아 이 규칙으로 알림을 받을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS staat niet toe dat Bento Stats meldingen stuurt, dus deze regels kunnen je niet waarschuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie pozwala aplikacji Bento Stats wysyłać powiadomień, więc te reguły nie mogą wysyłać alertów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não está permitindo que o Bento Stats envie notificações, então estas regras não podem alertar você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не разрешает Bento Stats отправлять уведомления, поэтому эти правила не смогут вас предупредить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Bento Stats'ın bildirim göndermesine izin vermiyor; bu nedenle bu kurallar sizi uyaramaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 不允许 Bento Stats 发送通知，因此这些规则无法提醒你。"
          }
        },
        "zh-Hant" : {
