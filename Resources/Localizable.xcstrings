    "Waiting for your answer to the macOS permission prompt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf deine Antwort auf die Berechtigungsanfrage von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando tu respuesta a la solicitud de permiso de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de votre réponse à la demande d'autorisation de macOS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu jawaban Anda atas permintaan izin macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa della tua risposta alla richiesta di autorizzazione di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSの許可ダイアログへの応答を待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 권한 요청에 대한 응답을 기다리는 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op je antwoord op het toestemmingsverzoek van macOS."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwanie na odpowiedź na prośbę macOS o pozwolenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando sua resposta à solicitação de permissão do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидается ваш ответ на запрос разрешения macOS."
          }
