    "%@ is already claimed by macOS or another app, so it was not assigned to %@. Record a different combination." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird bereits von macOS oder einer anderen App verwendet und wurde daher nicht „%@“ zugewiesen. Nimm eine andere Kombination auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La combinación %@ ya la usa macOS u otra app, así que no se ha asignado a %@. Graba otra combinación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci %@ est déjà utilisé par macOS ou une autre app, il n'a donc pas été attribué à « %@ ». Enregistrez une autre combinaison."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sudah dipakai oleh macOS atau app lain, sehingga tidak ditetapkan ke %2$@. Rekam kombinasi lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La combinazione %@ è già usata da macOS o da un'altra app, quindi non è stata assegnata a “%@”. Registra una combinazione diversa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はmacOSまたはほかのアプリですでに使用されているため、“%2$@”に割り当てられませんでした。別の組み合わせを記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) macOS 또는 다른 앱에서 이미 사용 중이므로 ‘%2$@’에 할당되지 않았습니다. 다른 조합을 기록하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt al gebruikt door macOS of een andere app en is daarom niet toegewezen aan ‘%@’. Neem een andere combinatie op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrót %@ jest już zajęty przez macOS lub inną aplikację, więc nie został przypisany do akcji „%@”. Nagraj inną kombinację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A combinação %@ já está em uso pelo macOS ou por outro app, então não foi atribuída a %@. Grave outra combinação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетание %@ уже занято macOS или другим приложением, поэтому оно не назначено действию «%@». Запишите другое сочетание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zaten macOS ya da başka bir uygulama tarafından kullanılıyor, bu yüzden “%2$@” eylemine atanmadı. Başka bir tuş birleşimi kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已被 macOS 或其他 App 占用，因此未分配给“%2$@”。请录制其他组合键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已被 macOS 或其他 App 佔用，因此未指定給「%2$@」。請錄製其他組合鍵。"
          }
        }
      }
    },
