    "Hot. macOS is slowing things down to cool off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heiß. macOS bremst, um abzukühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caliente. macOS está bajando el ritmo para enfriarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaud. macOS ralentit pour refroidir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panas. macOS memperlambat kinerja agar suhu turun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caldo. macOS rallenta per raffreddarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高温です。macOSが冷却のために処理を遅くしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뜨겁습니다. macOS가 열을 식히려고 속도를 낮추고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heet. macOS remt af om af te koelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorąco. macOS spowalnia pracę, aby schłodzić Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quente. O macOS está reduzindo o ritmo para esfriar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жарко. macOS замедляет работу, чтобы Mac остыл."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıcak. macOS soğumak için işleri yavaşlatıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度较高，macOS 正在降低性能以降温。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫度偏高，macOS 正在降低效能以降溫。"
          }
        }
      }
    },
