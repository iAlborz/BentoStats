    "Very hot. Performance is cut back hard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr heiß. Die Leistung wird stark gedrosselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy caliente. El rendimiento se reduce mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très chaud. Performances fortement réduites."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat panas. Kinerja dikurangi drastis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molto caldo. Prestazioni ridotte drasticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常に高温です。性能が大幅に制限されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매우 뜨겁습니다. 성능이 크게 제한되고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erg heet. De prestaties worden flink teruggeschroefd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardzo gorąco. Wydajność jest mocno ograniczona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito quente. O desempenho está bem reduzido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень жарко. Производительность сильно снижена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok sıcak. Performans ciddi biçimde düşürülüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度很高，性能已大幅降低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫度很高，效能已大幅降低。"
          }
        }
      }
    },
