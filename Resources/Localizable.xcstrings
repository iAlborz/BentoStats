    "At least one readout must stay visible so the menu bar item remains clickable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Messwert muss sichtbar bleiben, damit das Menüleistensymbol anklickbar bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos un indicador debe quedar visible para poder seguir haciendo clic en el ítem de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins un indicateur doit rester visible pour que l'élément de la barre des menus reste cliquable."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setidaknya satu indikator harus tetap terlihat agar item bar menu tetap dapat diklik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno un indicatore deve restare visibile perché l'elemento nella barra dei menu resti cliccabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目をクリックできるように、少なくとも1つの表示項目を表示したままにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 항목을 클릭할 수 있도록 표시 항목을 하나 이상 보이게 유지해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er moet minstens één meetwaarde zichtbaar blijven, zodat het menubalkonderdeel klikbaar blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej jeden odczyt musi pozostać widoczny, aby element na pasku menu dało się kliknąć."
          }
        },
        "pt-BR" : {
