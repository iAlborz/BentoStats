    "This copy is not signed, so it cannot check an update's signature. Download it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie ist nicht signiert und kann daher die Signatur eines Updates nicht prüfen. Lade das Update stattdessen herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia no está firmada, así que no puede comprobar la firma de una actualización. Descárgala manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie n'est pas signée et ne peut donc pas vérifier la signature d'une mise à jour. Téléchargez plutôt la mise à jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan ini tidak ditandatangani, sehingga tidak dapat memeriksa tanda tangan pembaruan. Sebagai gantinya, unduh pembaruan tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia non è firmata, quindi non può verificare la firma di un aggiornamento. Scarica invece l'aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコピーは署名されていないため、アップデートの署名を確認できません。代わりにダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사본은 서명되지 않아 업데이트의 서명을 확인할 수 없습니다. 대신 다운로드하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kopie is niet ondertekend en kan de handtekening van een update dus niet controleren. Download de update in plaats daarvan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia nie jest podpisana, więc nie może sprawdzić podpisu uaktualnienia. Pobierz je ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia não está assinada, então não pode verificar a assinatura de uma atualização. Baixe-a manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия не подписана, поэтому не может проверить подпись обновления. Скачайте обновление вручную."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kopya imzalı olmadığı için güncellemenin imzasını denetleyemez. Güncellemeyi bunun yerine indirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本未签名，因此无法检查更新的签名。请改为下载更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本未經簽署，因此無法檢查更新項目的簽名。請改為下載更新項目。"
          }
        }
      }
    },
