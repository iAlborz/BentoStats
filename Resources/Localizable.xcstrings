    "Thermal pressure is %@, at or past your %@ threshold." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der thermische Druck ist %@ und hat deine Schwelle „%@“ erreicht oder überschritten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado térmico es %@, igual o superior a tu umbral (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau de pression thermique : %@. Votre seuil (%@) est atteint ou dépassé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekanan termal saat ini %1$@, mencapai atau melewati ambang %2$@ Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livello di pressione termica: %@. La tua soglia (%@) è stata raggiunta o superata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱状態が“%1$@”になり、設定したしきい値（%2$@）以上です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발열 상태가 ‘%1$@’ 단계로, 설정한 임계값(%2$@) 이상입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thermische druk is %@ en heeft je drempel ‘%@’ bereikt of overschreden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie termiczne: %@. Ustawiony próg („%@”) został osiągnięty lub przekroczony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estado térmico é %@, igual ou acima do seu limite (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепловая нагрузка: %@ — ваш порог «%@» достигнут или превышен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termal baskı şu an %1$@; belirlediğiniz %2$@ eşiğine ulaştı ya da onu aştı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散热状态为“%1$@”，已达到或超过你设定的阈值“%2$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散熱狀態為「%1$@」，已達到或超過你設定的臨界值「%2$@」。"
          }
        }
      }
    },
