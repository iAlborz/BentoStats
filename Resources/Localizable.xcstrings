    "Notifies %@, then not again for %@. Threshold: %@. Needs the %@ collector, which this rule keeps running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt dich, %@, danach %@ lang nicht erneut. Schwelle: %@. Benötigt die Datenerfassung „%@“, die diese Regel weiterlaufen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa %@ y luego no vuelve a avisar durante %@. Umbral: %@. Necesita el recopilador de %@, que esta regla mantiene en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit %@, puis plus aucune alerte pendant %@. Seuil : %@. Nécessite le module %@, que cette règle maintient actif."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu %1$@, lalu tidak lagi selama %2$@. Ambang: %3$@. Memerlukan pengumpul %4$@, yang tetap dijalankan oleh aturan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa %@, poi non più per %@. Soglia: %@. Richiede il modulo %@, che questa regola mantiene attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@通知し、その後%2$@は再通知しません。しきい値: %3$@。%4$@の収集が必要なため、このルールにより収集が継続されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 알리고, 이후 %2$@ 동안 다시 알리지 않습니다. 임계값: %3$@. %4$@ 수집기가 필요하며, 이 규칙이 수집기를 계속 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuurt een melding %@, daarna %@ niet opnieuw. Drempel: %@. Vereist de gegevensverzameling ‘%@’, die door deze regel actief blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadamia %@, a kolejny raz nie wcześniej niż za %@. Próg: %@. Reguła korzysta ze źródła danych „%@” i utrzymuje je w działaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifica %@ e depois não notifica de novo por %@. Limite: %@. Precisa do coletor de %@, que esta regra mantém em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомляет %@, повторно — не раньше чем через %@. Порог: %@. Правило использует сборщик «%@» и не даёт ему остановиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim %1$@ gönderilir, ardından %2$@ boyunca tekrarlanmaz. Eşik: %3$@. Bu kural, gerektirdiği %4$@ toplayıcısını çalışır durumda tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
